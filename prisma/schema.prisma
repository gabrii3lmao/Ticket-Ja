generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  taxId        String?  @unique @db.VarChar(11)
  phone        String?  @db.VarChar(20)
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders              Order[]
  tickets             Ticket[]
  organizerProfiles   OrganizerProfile?
  gatewayCustomers    GatewayCustomer[]
  organizerAplication OrganizerAplication?
}

model OrganizerProfile {
  id        String   @id @default(uuid())
  legalName String
  tradeName String?
  // CPF ou CNPJ pro Split payment
  document  String   @unique @db.VarChar(14)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  venues          Venue[]
  events          Event[]
  paymentAccounts PaymentAccount[]
}

model OrganizerAplication {
  id             String                     @id @default(uuid())
  legalName      String
  tradeName      String?
  document       String                     @unique @db.VarChar(14)
  status         OrganizerApplicationStatus @default(PENDING)
  rejectedReason String?                    @db.Text
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  @@index([status])
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  street    String?
  number    String?  @db.VarChar(20)
  district  String?  @db.VarChar(120)
  city      String?  @db.VarChar(120)
  state     String?  @db.VarChar(2)
  zipCode   String?  @db.VarChar(20)
  capacity  Int
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizerProfileId String
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id])

  @@index([city])
  @@index([state])
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?     @db.Text()
  artists     String[]
  startDate   DateTime
  endDate     DateTime?
  imageUrl    String?     @db.VarChar(500)
  minimumAge  Int?
  status      EventStatus @default(DRAFT)
  categories  Category[]
  tickets     Ticket[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizerProfileId String
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Restrict)

  venueId String
  venue   Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  coupons Coupon[]

  @@index([organizerProfileId])
  @@index([venueId])
  @@index([startDate])
}

model Category {
  id          String      @id @default(uuid())
  name        String      @db.VarChar(100)
  description String?     @db.Text()
  price       Decimal     @db.Decimal(10, 2)
  quantity    Int
  salesStart  DateTime?
  salesEnd    DateTime?
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Order {
  id         String      @id @default(uuid())
  subtotal   Decimal     @db.Decimal(10, 2)
  discount   Decimal     @default(0) @db.Decimal(10, 2)
  fee        Decimal     @default(0) @db.Decimal(10, 2)
  total      Decimal     @db.Decimal(10, 2)
  status     OrderStatus @default(PENDING)
  orderItems OrderItem[]
  payments   Payment[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  tickets   Ticket[]

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([categoryId])
}

model Ticket {
  id        String       @id @default(uuid())
  qrCode    String       @unique @db.VarChar(255)
  code      String       @unique @db.VarChar(100)
  status    TicketStatus @default(VALID)
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
  @@index([userId])
  @@index([eventId])
}

model Payment {
  id            String          @id @default(uuid())
  provider      PaymentProvider
  paymentMethod PaymentMethod
  externalId    String?         @db.VarChar(255)
  amount        Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)
  paidAt        DateTime?
  providerData  Json?
  dueDate       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([provider, externalId])
}

model PaymentAccount {
  id        String          @id @default(uuid())
  provider  PaymentProvider
  accountId String
  isDefault Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  organizerProfileId String
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id])

  // impede duplicações
  @@unique([organizerProfileId, provider])
  @@index([organizerProfileId])
  @@index([provider])
}

model GatewayCustomer {
  id         String          @id @default(uuid())
  customerId String
  provider   PaymentProvider
  createdAt  DateTime        @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model PaymentWebhookEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([provider])
  @@index([eventId])
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique @db.VarChar(50)
  description  String       @db.Text()
  discountType DiscountType
  value        Decimal      @db.Decimal(10, 2)
  expiresAt    DateTime?
  maxUses      Int?
  currentUses  Int          @default(0)
  active       Boolean      @default(true)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  orders Order[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELED
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  ASAAS
  PAGSEGURO
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Role {
  BUYER
  ORGANIZER
  ADMIN
}

enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}
