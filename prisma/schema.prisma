generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events  Event[]
  orders  Order[]
  venues  Venue[]
  tickets Ticket[]
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  street    String?
  number    String?  @db.VarChar(20)
  district  String?  @db.VarChar(120)
  city      String?  @db.VarChar(120)
  state     String?  @db.VarChar(2)
  zipCode   String?  @db.VarChar(20)
  capacity  Int
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizerId String
  user        User   @relation(fields: [organizerId], references: [id])

  @@index([city])
  @@index([state])
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?     @db.Text()
  artists     String[]
  startDate   DateTime
  endDate     DateTime?
  imageUrl    String?     @db.VarChar(500)
  minimumAge  Int?
  status      EventStatus @default(DRAFT)
  categories  Category[]
  tickets     Ticket[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([organizerId])
  @@index([venueId])
  @@index([startDate])
}

model Category {
  id          String      @id @default(uuid())
  name        String      @db.VarChar(100)
  description String?     @db.Text()
  price       Decimal     @db.Decimal(10, 2)
  quantity    Int
  salesStart  DateTime?
  salesEnd    DateTime?
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Order {
  id         String      @id @default(uuid())
  subtotal   Decimal     @db.Decimal(10, 2)
  discount   Decimal     @default(0) @db.Decimal(10, 2)
  fee        Decimal     @default(0) @db.Decimal(10, 2)
  total      Decimal     @db.Decimal(10, 2)
  status     OrderStatus @default(PENDING)
  orderItems OrderItem[]
  payments   Payment[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  tickets   Ticket[]

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([categoryId])
}

model Ticket {
  id        String       @id @default(uuid())
  qrCode    String       @unique @db.VarChar(255)
  code      String       @unique @db.VarChar(100)
  status    TicketStatus @default(VALID)
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
  @@index([userId])
  @@index([eventId])
}

model Payment {
  id            String          @id @default(uuid())
  provider      PaymentProvider
  paymentMethod PaymentMethod
  transactionId String?         @db.VarChar(255)
  amount        Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime        @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELED
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  ASAAS
  PAGSEGURO
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum DiscountType {
  PERCENTAGE
  FIXED
}
